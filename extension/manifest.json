{
  "manifest_version": 3,
  "name": "Vasy AI Agent",
  "version": "17.3.1",
  "description": "Vasy AI copilot for VasyERP — run purchase, sales, stock, money and reports by chat or voice in 13 languages, from a movable chat bubble or a side-by-side console. No API key needed.",
  "author": "Moksheet Shah",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "system.memory",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VasyERP AI Agent Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.vasyerp.com/*",
        "*://*.vasyerp.in/*",
        "*://*.vasysit.com/*",
        "*://*.vasy.ai/*"
      ],
      "js": [
        "content_bubble.js"
      ],
      "css": [
        "bubble.css"
      ],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "*://*.vasyerp.com/*",
    "*://*.vasyerp.in/*",
    "*://*.vasysit.com/*",
    "*://*.vasy.ai/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content_agent.js",
        "landing.html",
        "icons/*.png"
      ],
      "matches": [
        "*://*.vasyerp.com/*",
        "*://*.vasyerp.in/*",
        "*://*.vasysit.com/*",
        "*://*.vasy.ai/*"
      ]
    }
  ],
  "commands": {
    "open-console": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Open the Vasy Console"
    }
  }
}
